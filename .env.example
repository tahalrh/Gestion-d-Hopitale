# ==============================================================================
# GESTION-D-HOPITALE - Configuration d'Environnement (.env.example)
# IMPORTANT: Copiez ce fichier sous le nom '.env' et remplacez les valeurs
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Base de Données (MySQL 8.0)
# ------------------------------------------------------------------------------
DB_HOST=db
DB_PORT=3306
DB_NAME=hopital_db
DB_USER=hopital_user
DB_PASSWORD=HopitalSecurite2026!
DB_ROOT_PASSWORD=RootAdminHopital2026!
DB_MAX_POOL_SIZE=10
DB_CONNECTION_TIMEOUT_MS=30000

# ------------------------------------------------------------------------------
# 2. Application & Serveur
# ------------------------------------------------------------------------------
APP_NAME=GestionHopital
APP_ENV=production
APP_PORT=8080
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 3. Sécurité & Conformité RGPD (Règlement Général sur la Protection des Données)
# ------------------------------------------------------------------------------
# Clé de chiffrement AES-256 pour les données de santé au repos (ex: NIR/Sécurité Sociale)
DATA_ENCRYPTION_KEY=dGhpc0lzQVZlcnlTZWN1cmVLZXlGb3JIZWFsdGgyMDI2IQ==

# Traçabilité et journalisation des accès aux dossiers médicaux (Art. 30 & 32 RGPD)
AUDIT_LOG_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=365

# Expiration automatique de session du personnel soignant (minutes)
SESSION_TIMEOUT_MINUTES=15
